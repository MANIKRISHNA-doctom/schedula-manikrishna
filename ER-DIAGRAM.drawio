<mxfile host="app.diagrams.net">
  <diagram name="Schedula ER Diagram" id="schedula-erd">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- USER -->
        <mxCell id="user" value="USER&#10;--------------------&#10;PK  user_id&#10;    mobile_number&#10;    name&#10;    created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- PATIENT -->
        <mxCell id="patient" value="PATIENT&#10;--------------------&#10;PK  patient_id&#10;FK  user_id&#10;    name&#10;    age&#10;    sex&#10;    weight&#10;    relation" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- SUPPORT_TICKET -->
        <mxCell id="support" value="SUPPORT_TICKET&#10;--------------------&#10;PK  ticket_id&#10;FK  user_id&#10;    subject&#10;    description&#10;    status&#10;    created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- NOTIFICATION -->
        <mxCell id="notification" value="NOTIFICATION&#10;--------------------&#10;PK  notification_id&#10;FK  user_id&#10;FK  appointment_id&#10;    message&#10;    type&#10;    created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- DOCTOR -->
        <mxCell id="doctor" value="DOCTOR&#10;--------------------&#10;PK  doctor_id&#10;    name&#10;    specialization&#10;    experience_years&#10;    qualification&#10;    rating" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="40" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- SLOT -->
        <mxCell id="slot" value="SLOT&#10;--------------------&#10;PK  slot_id&#10;FK  doctor_id&#10;    slot_date&#10;    start_time&#10;    end_time&#10;    status" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="240" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- APPOINTMENT (center, highlighted) -->
        <mxCell id="appointment" value="APPOINTMENT&#10;--------------------&#10;PK  appointment_id&#10;FK  patient_id&#10;FK  doctor_id&#10;FK  slot_id&#10;FK  user_id&#10;    token_number&#10;    visit_type&#10;    complaint&#10;    status&#10;    created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="280" width="240" height="220" as="geometry" />
        </mxCell>

        <!-- PAYMENT -->
        <mxCell id="payment" value="PAYMENT&#10;--------------------&#10;PK  payment_id&#10;FK  appointment_id&#10;    amount&#10;    status&#10;    paid_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="600" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- FEEDBACK -->
        <mxCell id="feedback" value="FEEDBACK&#10;--------------------&#10;PK  feedback_id&#10;FK  appointment_id&#10;    consulting_rating&#10;    hospital_rating&#10;    waiting_rating&#10;    comments" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- EDGES with plain 1:1 / 1:N labels -->
        <mxCell id="e1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="patient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="support">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="notification">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="user" target="appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="doctor" target="slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="doctor" target="appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d79b00;" edge="1" parent="1" source="slot" target="appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d79b00;" edge="1" parent="1" source="appointment" target="payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d79b00;" edge="1" parent="1" source="appointment" target="feedback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e11" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="appointment" target="notification">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend&#10;--------------------&#10;1 : N  = one record relates to many records&#10;1 : 1  = one record relates to at most one record&#10;(the box on the &quot;many&quot; side holds the foreign key)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="440" width="300" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
